{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "task-set",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  // The Hanoryx Systems account, which owns the hanoryx.com zone.
  "account_id": "0247048d3068108cdfca3d15e617d040",
  // Served only on the custom domain.
  "routes": [{ "pattern": "task.hanoryx.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "TASK_SPACE", "class_name": "TaskSpace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TaskSpace"] }],
  "ratelimits": [
    { "name": "AI_RATE_LIMIT", "namespace_id": "1947021", "simple": { "limit": 6, "period": 60 } },
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "1947022", "simple": { "limit": 5, "period": 60 } }
  ],
  // OPENROUTER_API_KEY is optional: when set, OpenRouter answers task suggestions if Workers AI fails.
  "secrets": { "required": ["APP_PASSCODE", "SESSION_SECRET"] },
  "observability": { "enabled": true }
}
