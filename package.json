{
  "name": "task-set",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "guardrails": "node scripts/guardrails.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vitest run",
    "validate": "npm run guardrails && npm run check && npm run build",
    "worker:dev": "wrangler dev",
    "worker:preview": "npm run build && wrangler preview",
    "worker:dry-run": "wrangler deploy --dry-run",
    "deploy": "npm run validate && wrangler deploy",
    "deploy:first": "npm run validate && node scripts/first-deploy.mjs"
  },
  "dependencies": {
    "chrono-node": "^2.10.3",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.139.0"
  }
}
