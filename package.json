{
  "name": "task-set",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "guardrails": "node scripts/guardrails.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vitest run",
    "validate": "npm run guardrails && npm run check && npm run build",
    "worker:dev": "wrangler dev",
    "worker:preview": "npm run build && wrangler preview",
    "worker:dry-run": "wrangler deploy --dry-run",
    "deploy": "npm run validate && wrangler deploy",
    "deploy:first": "npm run validate && node scripts/first-deploy.mjs",
    "worker:local": "node scripts/dev-local.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "chrono-node": "^2.10.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@types/google.maps": "^3.66.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.139.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
