# Optional browser key. Enable Maps JavaScript API and Places API (New).
# Restrict this key to your site HTTP referrers and those two APIs.
# Copy to .env.local (ignored by git) and rebuild; never put GITHUB_TOKEN here.
VITE_GOOGLE_MAPS_API_KEY=
# Create your own JavaScript map ID for production advanced markers.
VITE_GOOGLE_MAPS_MAP_ID=
